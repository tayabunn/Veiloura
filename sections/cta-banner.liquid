{%- liquid
  assign bg_img = section.settings.bg_image | image_url: width: 2000 | default: "https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=2000&auto=format&fit=crop"
-%}

<section class="cta-banner-section" aria-label="Fashion Banner Callout">
  <img 
    src="{{ bg_img }}" 
    alt="Stratosphere Banner Background" 
    class="cta-banner-bg"
    loading="lazy"
    width="1920"
    height="600"
  >
  
  <div class="page-container cta-banner-content">
    <h2 class="cta-banner-title">{{ section.settings.heading }}</h2>
    <p class="cta-banner-subtext">{{ section.settings.subheading }}</p>
    
    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_url }}" class="btn btn-light">
        {{ section.settings.button_text }} ↗
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Stratosphere CTA Banner",
  "tag": "section",
  "class": "section-cta-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let's Take Your Fashion to The Stratosphere"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Ready to elevate your style? Let's launch your fashion into the stratosphere with bold choices and unique trends!"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Get Started Now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button Link URL",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Stratosphere CTA Banner"
    }
  ]
}
{% endschema %}
