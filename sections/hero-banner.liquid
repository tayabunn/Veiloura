{%- liquid
  assign bg_image_url = section.settings.bg_image | image_url: width: 2000 | default: "https://images.unsplash.com/photo-1441986300917-64674bd600d8?q=80&w=2000&auto=format&fit=crop"
  assign preview_image_url = section.settings.preview_product_image | image_url: width: 800 | default: "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?q=80&w=800&auto=format&fit=crop"
  assign container_radius = section.settings.container_border_radius | default: 10
-%}

<section class="hero-section" aria-label="Hero Banner">
  <div class="page-container">
    <!-- Hero Inset Card Container with Border Radius & Customizable Height -->
    <div class="hero-banner-card" style="--hero-border-radius: {{ container_radius }}px; min-height: {{ section.settings.hero_height | default: 850 }}px;">
      
      <!-- Background Image -->
      <div class="hero-bg-wrapper">
        <img 
          src="{{ bg_image_url }}" 
          alt="Hero Fashion Background" 
          class="hero-bg-img"
          loading="eager"
          width="1920"
          height="1080"
        >
      </div>

      <!-- Diagonal Linear Dark Gradient (135deg: 7% #000000 100% -> 100% #000000 0%) -->
      <div class="hero-overlay-gradient" style="opacity: {{ section.settings.gradient_opacity | divided_by: 100.0 | default: 0.95 }};"></div>

      <!-- Hero Main Content Grid -->
      <div class="hero-content-inner">
        <!-- Main Headline & Subheading (Left Top) -->
        <div class="hero-text-content">
          <h1 class="hero-heading">
            {{ section.settings.heading | escape }}
          </h1>
          <p class="hero-subtext">
            {{ section.settings.subheading | escape }}
          </p>
        </div>

        <!-- Bottom Tag Highlights Bar -->
        <div class="hero-tags-bar">
          {% for block in section.blocks %}
            {% if block.type == 'tag_item' %}
              <span class="hero-tag-item" {{ block.shopify_attributes }}>
                {{ block.settings.tag_text }}
              </span>
            {% endif %}
          {% endfor %}
        </div>

        <!-- Floating Featured Product Preview Card (Top Right Alignment) -->
        <div class="hero-product-preview">
          <div class="hero-preview-top">
            <span class="hero-preview-title-top">{{ section.settings.preview_badge_text }}</span>
            <div class="hero-preview-controls">
              <button type="button" class="hero-nav-arrow prev" aria-label="Previous featured preview">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
              </button>
              <button type="button" class="hero-nav-arrow next active" aria-label="Next featured preview">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
            </div>
          </div>

          <div class="hero-preview-image-box">
            <img 
              src="{{ preview_image_url }}" 
              alt="{{ section.settings.preview_product_title }}"
              loading="lazy"
              width="400"
              height="400"
            >
          </div>

          <div class="hero-preview-info">
            <div class="hero-preview-title-price-row">
              <h2 class="hero-preview-title">{{ section.settings.preview_product_title }}</h2>
              <span class="hero-preview-price">{{ section.settings.preview_product_price }}</span>
            </div>
            <span class="hero-preview-category">{{ section.settings.preview_product_category }}</span>
          </div>

          <button type="button" class="hero-preview-add-btn js-add-to-cart">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            Add to Chart
          </button>
        </div>

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner Section",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Hero Background Image"
    },
    {
      "type": "range",
      "id": "container_border_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 8,
      "unit": "px",
      "label": "Hero Inset Border Radius"
    },
    {
      "type": "range",
      "id": "hero_height",
      "min": 550,
      "max": 950,
      "step": 25,
      "default": 850,
      "unit": "px",
      "label": "Hero Desktop Min Height"
    },
    {
      "type": "range",
      "id": "gradient_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 95,
      "unit": "%",
      "label": "Diagonal Overlay Gradient Opacity"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Title",
      "default": "Unleash Your Style with Our New Collection"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading Description",
      "default": "Unleash your style and express individuality with our new collection, designed to elevate your wardrobe and make a bold statement wherever you go."
    },
    {
      "type": "header",
      "content": "Floating Product Card Preview"
    },
    {
      "type": "text",
      "id": "preview_badge_text",
      "label": "Badge Text",
      "default": "New Collection"
    },
    {
      "type": "image_picker",
      "id": "preview_product_image",
      "label": "Preview Product Image"
    },
    {
      "type": "text",
      "id": "preview_product_title",
      "label": "Preview Product Title",
      "default": "Nerdy Sparkling Short Sleeve T-Shirt Black"
    },
    {
      "type": "text",
      "id": "preview_product_category",
      "label": "Preview Product Category",
      "default": "Apparel • Shirt"
    },
    {
      "type": "text",
      "id": "preview_product_price",
      "label": "Preview Product Price",
      "default": "$150"
    }
  ],
  "blocks": [
    {
      "type": "tag_item",
      "name": "Tag Highlight",
      "settings": [
        {
          "type": "text",
          "id": "tag_text",
          "label": "Tag Text",
          "default": "Keep Stylish"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner Section",
      "blocks": [
        {
          "type": "tag_item",
          "settings": {
            "tag_text": "Keep Stylish"
          }
        },
        {
          "type": "tag_item",
          "settings": {
            "tag_text": "Fashion for Every Women"
          }
        },
        {
          "type": "tag_item",
          "settings": {
            "tag_text": "Trendy Fashion"
          }
        }
      ]
    }
  ]
}
{% endschema %}
