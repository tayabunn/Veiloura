<section class="value-props-section" aria-label="Customer Experience Features">
  <div class="page-container">
    <!-- Header -->
    <div class="value-props-header">
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      <p class="section-subtitle">{{ section.settings.subheading }}</p>
    </div>

    <!-- 3 Feature Columns -->
    <div class="value-props-grid">
      {% for block in section.blocks %}
        <div class="value-prop-card" {{ block.shopify_attributes }}>
          <div class="value-prop-icon-box">
            {% case block.settings.icon_type %}
              {% when 'support' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
              {% when 'collection' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="8.5" cy="7" r="4"></circle>
                  <line x1="20" y1="8" x2="20" y2="14"></line>
                  <line x1="23" y1="11" x2="17" y2="11"></line>
                </svg>
              {% when 'satisfaction' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
                  <line x1="9" y1="9" x2="9.01" y2="9"></line>
                  <line x1="15" y1="9" x2="15.01" y2="9"></line>
                </svg>
              {% else %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
            {% endcase %}
          </div>
          <h3 class="value-prop-title">{{ block.settings.title }}</h3>
          <p class="value-prop-desc">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Value Props Features",
  "tag": "section",
  "class": "section-value-props",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We Deliver Exceptional Customer Experiences"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We are committed to delivering exceptional customer experiences that exceed expectations and make every interaction memorable."
    }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "Feature Card",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon",
          "options": [
            { "value": "support", "label": "Support Chat" },
            { "value": "collection", "label": "New Collection / User" },
            { "value": "satisfaction", "label": "Satisfaction Smile" }
          ],
          "default": "support"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Quick and Friendly Support"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Our support team responds quickly and is friendly, ensuring your experience is efficient and pleasant. We prioritize your needs and assist you every step."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value Props Features",
      "blocks": [
        {
          "type": "feature_card",
          "settings": {
            "icon_type": "support",
            "title": "Quick and Friendly Support",
            "description": "Our support team responds quickly and is friendly, ensuring your experience is efficient and pleasant. We prioritize your needs and assist you every step."
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "icon_type": "collection",
            "title": "New Collection Everyday",
            "description": "Our new collection launched daily! Each piece is designed to add a fresh twist to your style. Stay tuned for updates and find something special!"
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "icon_type": "satisfaction",
            "title": "Satisfaction Guaranteed",
            "description": "We guarantee your satisfaction with our support team, quick to respond and friendly. Your experience is our priority, and we're here to assist you."
          }
        }
      ]
    }
  ]
}
{% endschema %}
