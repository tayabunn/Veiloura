<footer class="site-footer" role="contentinfo">
  <div class="page-container">
    <!-- Top Grid -->
    <div class="footer-top-grid">
      <!-- Brand & Social Column -->
      <div class="footer-brand-col">
        <div class="footer-social-links">
          <a href="#" class="footer-social-icon" aria-label="X (Twitter)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a href="#" class="footer-social-icon" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
            </svg>
          </a>
          <a href="#" class="footer-social-icon" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
            </svg>
          </a>
          <a href="#" class="footer-social-icon" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
        </div>

        <div class="footer-contact-info">
          <p>{{ section.settings.address_text }}</p>
          <p>{{ section.settings.email_text }}</p>
          <p>{{ section.settings.phone_text }}</p>
        </div>
      </div>

      <!-- Column 1: Product -->
      <div class="footer-nav-col">
        <h4 class="footer-nav-col-title">Product</h4>
        <ul class="footer-nav-list">
          <li><a href="#" class="footer-nav-link">Accessories</a></li>
          <li><a href="#" class="footer-nav-link">Sneakers</a></li>
          <li><a href="#" class="footer-nav-link">T-Shirts & Pants</a></li>
          <li><a href="#" class="footer-nav-link">Jackets & Blazers</a></li>
        </ul>
      </div>

      <!-- Column 2: Support -->
      <div class="footer-nav-col">
        <h4 class="footer-nav-col-title">Support</h4>
        <ul class="footer-nav-list">
          <li><a href="#" class="footer-nav-link">Support Center</a></li>
          <li><a href="#" class="footer-nav-link">FAQs</a></li>
          <li><a href="#" class="footer-nav-link">Troubleshooting</a></li>
          <li><a href="#" class="footer-nav-link">Feedback</a></li>
        </ul>
      </div>

      <!-- Column 3: Company -->
      <div class="footer-nav-col">
        <h4 class="footer-nav-col-title">Company</h4>
        <ul class="footer-nav-list">
          <li><a href="#" class="footer-nav-link">About Us</a></li>
          <li><a href="#" class="footer-nav-link">Careers</a></li>
          <li><a href="#" class="footer-nav-link">Blog</a></li>
          <li><a href="#" class="footer-nav-link">Contact</a></li>
        </ul>
      </div>

      <!-- Column 4: Legal -->
      <div class="footer-nav-col">
        <h4 class="footer-nav-col-title">Legal</h4>
        <ul class="footer-nav-list">
          <li><a href="#" class="footer-nav-link">Privacy Policy</a></li>
          <li><a href="#" class="footer-nav-link">Terms of Service</a></li>
          <li><a href="#" class="footer-nav-link">Cookie Policy</a></li>
          <li><a href="#" class="footer-nav-link">Compliance</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Row -->
    <div class="footer-bottom-row">
      <p>{{ section.settings.copyright_text }}</p>
      <div class="footer-legal-links">
        <a href="#" class="footer-nav-link">Privacy Policy</a>
        <a href="#" class="footer-nav-link">Terms Of Use</a>
      </div>
    </div>
  </div>

  <!-- Giant Display Branding Typography -->
  <div class="footer-brand-huge-text">
    {{ section.settings.brand_huge_text }}
  </div>
</footer>

{% schema %}
{
  "name": "Footer Section",
  "tag": "section",
  "class": "section-footer-wrapper",
  "settings": [
    {
      "type": "textarea",
      "id": "address_text",
      "label": "Address Info",
      "default": "4567 Oak Avenue, Rivertown, CA 90210, is a charming area with friendly faces."
    },
    {
      "type": "text",
      "id": "email_text",
      "label": "Email Contact",
      "default": "info@veiloura.com"
    },
    {
      "type": "text",
      "id": "phone_text",
      "label": "Phone Contact",
      "default": "(+89) 090 800 123"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "Copyright © ESSENTIAL 2025"
    },
    {
      "type": "text",
      "id": "brand_huge_text",
      "label": "Giant Footer Brand Text",
      "default": "VEILOURA"
    }
  ],
  "presets": [
    {
      "name": "Footer Section"
    }
  ]
}
{% endschema %}
