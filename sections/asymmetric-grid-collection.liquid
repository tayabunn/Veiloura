<section class="asymmetric-collection-section" aria-label="New Collection Asymmetric Grid">
  <div class="page-container">
    <!-- Header -->
    <div class="section-header">
      <div class="section-header-left">
        <h2 class="section-title">{{ section.settings.heading }}</h2>
        <p class="section-subtitle">{{ section.settings.subheading }}</p>
      </div>

      <div class="nav-arrows-group">
        <button type="button" class="btn-icon" aria-label="Previous items">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
        </button>
        <button type="button" class="btn-icon btn-icon-dark" aria-label="Next items">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- Asymmetric 3-Column Bento Masonry Grid -->
    <div class="asymmetric-grid">
      <!-- Column 1: Left Stacked Cards -->
      <div class="asymmetric-column">
        {% render 'product-card', 
          fallback_title: "Saavan X Shirt", 
          fallback_price: "$300", 
          fallback_compare_price: "$350", 
          fallback_item_count: "(10 Item)",
          fallback_image: "https://images.unsplash.com/photo-1602810318383-e386cc2a3ccf?q=80&w=800&auto=format&fit=crop"
        %}
        
        {% render 'product-card', 
          fallback_title: "Avan JX Shirt", 
          fallback_price: "$200", 
          fallback_compare_price: "$350", 
          fallback_item_count: "(65 Item)",
          fallback_image: "https://images.unsplash.com/photo-1598033129183-c4f50c736f10?q=80&w=800&auto=format&fit=crop"
        %}
      </div>

      <!-- Column 2: Middle Tall Hero Feature Card -->
      <div class="asymmetric-column">
        <div class="asymmetric-card-tall">
          {% render 'product-card', 
            fallback_title: "Blue Jacket and Short Jeans", 
            fallback_price: "$300", 
            fallback_compare_price: "$550", 
            fallback_item_count: "(15 Item)",
            fallback_image: "https://images.unsplash.com/photo-1548883354-7622d03aca27?q=80&w=800&auto=format&fit=crop"
          %}
        </div>
      </div>

      <!-- Column 3: Right Stacked Cards -->
      <div class="asymmetric-column">
        {% render 'product-card', 
          fallback_title: "Saryan X Shirt", 
          fallback_price: "$700", 
          fallback_compare_price: "$950", 
          fallback_item_count: "(10 Item)",
          fallback_image: "https://images.unsplash.com/photo-1576995853123-5a10305d93c0?q=80&w=800&auto=format&fit=crop"
        %}

        {% render 'product-card', 
          fallback_title: "Liam FP Shirt", 
          fallback_price: "$500", 
          fallback_compare_price: "$600", 
          fallback_item_count: "(8 Item)",
          fallback_image: "https://images.unsplash.com/photo-1562157873-818bc0726f68?q=80&w=800&auto=format&fit=crop"
        %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "New Collection Bento Grid",
  "tag": "section",
  "class": "section-asymmetric-collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Our New Collection"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover and dive into our most popular and best-selling categories that everyone is talking about!"
    }
  ],
  "presets": [
    {
      "name": "New Collection Bento Grid"
    }
  ]
}
{% endschema %}
