<section class="featured-collection-section" aria-label="Featured Collection">
  <div class="page-container">
    <!-- Section Header -->
    <div class="section-header">
      <div class="section-header-left">
        <h2 class="section-title">{{ section.settings.heading }}</h2>
        <p class="section-subtitle">{{ section.settings.subheading }}</p>
      </div>

      {% if section.settings.show_cta_button %}
        <a href="{{ section.settings.cta_url }}" class="btn btn-dark">
          {{ section.settings.cta_text }} 🛍️
        </a>
      {% endif %}
    </div>

    <!-- Category Filter Tabs Bar -->
    <div class="category-filter-bar" role="tablist" aria-label="Filter products by category">
      <button type="button" class="filter-tab active" data-category="all" role="tab" aria-selected="true">All Collection</button>
      <button type="button" class="filter-tab" data-category="knitwear" role="tab">Knitwear</button>
      <button type="button" class="filter-tab" data-category="jeans" role="tab">Jeans</button>
      <button type="button" class="filter-tab" data-category="trousers" role="tab">Trousers</button>
      <button type="button" class="filter-tab" data-category="t-shirts" role="tab">T-Shirts</button>
      <button type="button" class="filter-tab" data-category="jackets" role="tab">Jackets</button>
      <button type="button" class="filter-tab" data-category="swim-short" role="tab">Swim Short</button>
      <button type="button" class="filter-tab" data-category="long-sleeve" role="tab">Long Sleeve</button>
    </div>

    <!-- Product Grid -->
    <div class="product-grid">
      {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        <!-- Fallback Figma Sample Products -->
        {% render 'product-card', 
          fallback_title: "Sadie Jeans Sheets", 
          fallback_price: "$450", 
          fallback_compare_price: "$500", 
          fallback_item_count: "(20 Item)",
          fallback_image: "https://images.unsplash.com/photo-1541099649105-f69ad21f3246?q=80&w=800&auto=format&fit=crop",
          category_tag: "jeans"
        %}
        
        {% render 'product-card', 
          fallback_title: "Kato X Zip Shirt", 
          fallback_price: "$300", 
          fallback_compare_price: "$350", 
          fallback_item_count: "(15 Item)",
          fallback_image: "https://images.unsplash.com/photo-1596755094514-f87e34085b2c?q=80&w=800&auto=format&fit=crop",
          category_tag: "t-shirts"
        %}
        
        {% render 'product-card', 
          fallback_title: "Sarlo SS Shirt", 
          fallback_price: "$220", 
          fallback_compare_price: "$270", 
          fallback_item_count: "(25 Item)",
          fallback_image: "https://images.unsplash.com/photo-1618354691373-d851c5c3a990?q=80&w=800&auto=format&fit=crop",
          category_tag: "knitwear"
        %}

        {% render 'product-card', 
          fallback_title: "Norsbro Crew Neck", 
          fallback_price: "$250", 
          fallback_compare_price: "$500", 
          fallback_item_count: "(10 Item)",
          fallback_image: "https://images.unsplash.com/photo-1583743814966-8936f5b7be1a?q=80&w=800&auto=format&fit=crop",
          category_tag: "long-sleeve"
        %}

        {% render 'product-card', 
          fallback_title: "Norsbro Crew Neck", 
          fallback_price: "$250", 
          fallback_compare_price: "$350", 
          fallback_item_count: "(15 Item)",
          fallback_image: "https://images.unsplash.com/photo-1576995853123-5a10305d93c0?q=80&w=800&auto=format&fit=crop",
          category_tag: "jackets"
        %}

        {% render 'product-card', 
          fallback_title: "Saniklas Hoodie", 
          fallback_price: "$220", 
          fallback_compare_price: "$270", 
          fallback_item_count: "(25 Item)",
          fallback_image: "https://images.unsplash.com/photo-1556905055-8f358a7a47b2?q=80&w=800&auto=format&fit=crop",
          category_tag: "knitwear"
        %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Best Sellers",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Our Best Selling Product Collection"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover and dive into our most popular and best-selling categories that everyone is talking about!"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 6,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_cta_button",
      "label": "Show Shop Now CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Let's Shop Now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Link URL",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Featured Best Sellers"
    }
  ]
}
{% endschema %}
