            "fallback_img_url": "https://images.unsplash.com/photo-1556905055-8f358a7a47b2?q=80&w=800&auto=format&fit=crop"
          }
        },
        {
          "type": "recommendation_card",
          "settings": {
            "title": "The Athletic Joggers are Designed for Performance and Comfort.",
